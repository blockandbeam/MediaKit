# Copy this file to `.env` and fill in your credentials for
# https://maven.blockandbeam.de. `.env` is gitignored.
#
# Real environment variables (MAVEN_USERNAME / MAVEN_PASSWORD) take
# precedence over the values here.
#
# For a Cloudflare Access service token: username = Client ID,
# password = Client Secret.
MAVEN_USERNAME=
MAVEN_PASSWORD=
